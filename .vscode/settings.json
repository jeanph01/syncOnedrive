{
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.psm1": "powershell",
        "*.ps1": "powershell"
    },
    "[powershell]": {
        "files.encoding": "utf8",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-vscode.PowerShell"
    }
}
