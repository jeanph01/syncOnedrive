{
  "_comments": {
    "purpose": "Unified routing + naming rules for OneDrive Organizer.",
    "routingRules": "Defines action priority, folder overrides, and destination templates.",
    "namingRules": "Defines full naming logic: timestamp, gps, tags, original, media, dedup, ASCII normalization.",
    "gpsRules": "Defines GPS resolution, caching, fallback, and formatting.",
    "tagRules": "Defines extraction and cleaning of path-based tags.",
    "mediaRules": "Defines extraction and cleaning of camera/video metadata.",
    "cleanerRules": "Duplicate scoring rules."
  },

  "extensionMap": {
    ".jpg": "Images", ".jpeg": "Images", ".png": "Images",
    ".bmp": "Images", ".heic": "Images", ".heif": "Images",
    ".tif": "Images", ".tiff": "Images", ".svg": "Images", ".psd": "Images",
    ".ai": "Images", ".xcf": "Images", ".ico": "Images", ".thm": "Images",
    ".mp4": "Videos", ".mov": "Videos", ".avi": "Videos", ".mkv": "Videos",
    ".wmv": "Videos", ".webm": "Videos", ".m4v": "Videos", ".3gp": "Videos",
    ".mpg": "Videos", ".mpeg": "Videos", ".flv": "Videos",
    ".mp3": "Audio", ".wav": "Audio", ".m4a": "Audio", ".flac": "Audio",
    ".amr": "Audio", ".opus": "Audio"
  },
  // New: Animated image extensions
  ".gif": "Animated", ".webp": "Animated", ".apng": "Animated"

  "routingRules": {
    "actionPriority": [
      "confidential",
      "administrative",
      "no_action",
      "Animated",
      "default",
      "only_rename"
    ],

    "actions": {
      "default": {
        "destination": "<media>/<year>/<month>/",
        "filename": "<finalName>",
        "keepLevels": 0
      },

      "administrative": {
        "destination": "<level1>/<level2>/",
        "filename": "<finalName>",
        "keepLevels": 2
      },

      "confidential": {
        "destination": "<level1>/<level2>/<media>/<year>/<month>/",
        "filename": "<finalName>",
        "keepLevels": 2
      },

      "only_rename": {
        "destination": "<same_directory>/",
        "filename": "<finalName>",
        "keepLevels": 0
      },

      "no_action": {
        "destination": null,
        "filename": "<original><ext>",
        "keepLevels": 0
      },

      "Animated": {
        "destination": "Videos/<year>/<month>/",
        "filename": "<finalName>",
        "keepLevels": 0
      }
    },

    "confidentialRegexList": [
      "(?i)confidential",
      "(?i)privatevault",
      "(?i)securevault",
      "(?i)coffre.*fort",
      "(?i)verscoffrefort"
    ]
  },

  "folderRules": {
    "bureau": "default",
    "Cuisine": "no_action",
    "Documents": "no_action",
    "Fichiers Microsoft Copilot Chat": "default",
    "Fichiers transcrits": "no_action",
    "films": "no_action",
    "Finances": "only_rename",
    "Images": "default",
    "Importations": "no_action",
    "jp": "default",
    "JPM": "default",
    "Livres": "no_action",
    "Loisirs": "no_action",
    "Légal": "no_action",
    "Music": "default",
    "packages informatique": "no_action",
    "Pièces jointes": "no_action",
    "scan": "only_rename",
    "CoffreFort": "confidential",
    "VersCoffreFort": "confidential",
    "Videos": "default",
    "Vidéos": "default",
    "Vie des enfants": "administrative"
  },

  "namingRules": {
    "stopWords": [
      "de", "du", "des", "la", "le", "les",
      "avec", "pour", "sur", "dans", "et",
      "en", "a", "au", "aux"
    ],
    "renameMarker": "--odr--",
    "maxNameLength": 180,
    "finalPattern": "<timestamp>_<gps>_<tags>_<original>_<media>_<dup>"
  },

  "gpsRules": {
    "gridPrecision": 4,
    "fallbackDelta": 0.01,
    "cacheEnabled": true,
    "fieldsPriority": [
      "city", "town", "village", "hamlet",
      "suburb", "municipality", "county",
      "state", "country"
    ],
    "format": "<city>-<state>-<country>",
    "normalizeAscii": true
  },

  "tagRules": {
    "splitPattern": "[ _-]",
    "removeStopWords": true,
    "normalizeAscii": true
  },

  "mediaRules": {
    "extractCameraModel": true,
    "extractVideoDuration": true,
    "shortVideoMaxDurationMs": 60000, // Max duration in milliseconds for camera videos to be treated as images (e.g., 60 seconds)
    "normalizeAscii": true,
    "splitPattern": "[ _-]"
  },

  "cleanerRules": {
    "priorityRules": [
      { "field": "name", "pattern": "* - Copie*", "score": 50 },
      { "field": "name", "pattern": "* (1)*", "score": 40 },
      { "field": "path", "pattern": "*/Importations/*", "score": 30 },
      { "field": "path", "pattern": "*/Old/*", "score": 20 },
      { "field": "path", "pattern": "*/bureau/*", "score": 10 }
    ]
  }
}
