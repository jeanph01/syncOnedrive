{
  "_comments": {
    "purpose": "Externalized business rules. JSON does not support native comments, this block describes the sections.",
    "extensionMap": "Maps extension -> media category used by routing.",
    "routingRules": "Destination rules for files.",
    "folderRules": "Folder-based action overrides.",
    "namingRules": "Word cleaning rules for name generation.",
    "cleanerRules": "Scoring rules to keep/remove cloud duplicates."
  },

  "extensionMap": {
    ".jpg": "Images",
    ".jpeg": "Images",
    ".png": "Images",
    ".gif": "Images",
    ".bmp": "Images",
    ".webp": "Images",
    ".heic": "Images",
    ".heif": "Images",
    ".tif": "Images",
    ".tiff": "Images",
    ".svg": "Images",
    ".psd": "Images",
    ".ai": "Images",
    ".xcf": "Images",
    ".ico": "Images",
    ".thm": "Images",
    ".mp4": "Videos",
    ".mov": "Videos",
    ".avi": "Videos",
    ".mkv": "Videos",
    ".wmv": "Videos",
    ".webm": "Videos",
    ".m4v": "Videos",
    ".3gp": "Videos",
    ".mpg": "Videos",
    ".mpeg": "Videos",
    ".flv": "Videos",
    ".mp3": "Audio",
    ".wav": "Audio",
    ".m4a": "Audio",
    ".flac": "Audio",
    ".amr": "Audio",
    ".opus": "Audio"
  },

  "routingRules": {
    "actionPriority": [
      "confidential",
      "administrative",
      "no_action",
      "only_rename",
      "default"
    ],

    "actions": {
      "confidential": {
    "description": "Keep first 2 levels, then move and rename. Parent folder names are NOT included in final filename.",
        "destination": "<level1>/<level2>/<media>/<year>/<month>/name.ext"
      },
      "administrative": {
    "description": "Keep first 2 levels (instead of 3), then move and rename. Parent folder names are NOT included in final filename.",
    "destination": "<level1>/<level2>/name.ext"
      },
      "no_action": {
        "description": "Do nothing.",
        "destination": null
      },
      "default": {
    "description": "Move and rename into media/year/month. Parent folder names are NOT included in final filename.",
        "destination": "<media>/<year>/<month>/name.ext"
      },
      "only_rename": {
        "description": "Rename only, do not move.",
        "destination": "same_directory/name.ext"
      }
    },

    "confidentialRegexList": [
      "(?i)confidential",
      "(?i)privatevault",
      "(?i)securevault",
      "(?i)coffre.*fort",
      "(?i)verscoffrefort"
    ]
  },

  "folderRules": {
    "*.*": "default",
    "bureau": "default",
    "Cuisine": "administrative",
    "Documents": "default",
    "Fichiers Microsoft Copilot Chat": "default",
    "Fichiers transcrits": "no_action",
    "films": "no_action",
    "Finances": "only_rename",
    "Images": "default",
    "Importations": "no_action",
    "jp": "default",
    "JPM": "default",
    "Livres": "no_action",
    "Loisirs": "administrative",
    "Légal": "administrative",
    "Music": "default",
    "packages informatique": "no_action",
    "Pièces jointes": "no_action",
    "scan": "only_rename",
    "CoffreFort": "confidential",
    "VersCoffreFort": "confidential",
    "Videos": "default",
    "Vidéos": "default",
    "Vie_des_enfants": "administrative"
  },

  "namingRules": {
    "stopWords": [
      "de",
      "du",
      "des",
      "la",
      "le",
      "les",
      "avec",
      "pour",
      "sur",
      "dans",
      "et",
      "en",
      "a",
      "au",
      "aux"
    ]
  },

  "cleanerRules": {
    "priorityRules": [
      {
        "field": "name",
        "pattern": "* - Copie*",
        "score": 50
      },
      {
        "field": "name",
        "pattern": "* (1)*",
        "score": 40
      },
      {
        "field": "path",
        "pattern": "*/Importations/*",
        "score": 30
      },
      {
        "field": "path",
        "pattern": "*/Old/*",
        "score": 20
      },
      {
        "field": "path",
        "pattern": "*/bureau/*",
        "score": 10
      }
    ]
  }
}
