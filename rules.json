      "Messenger",
      "Instagram"
    ]
  },
  "namingRules": {
    "stopWords": [
      "de",
      "du",
      "des",
      "la",
      "le",
      "les",
      "avec",
      "pour",
      "sur",
      "dans",
      "et",
      "en",
      "a",
      "au",
      "aux"
    ]
  },
  "cleanerRules": {
    "priorityRules": [
      {
        "field": "name",
        "pattern": "* - Copie*",
        "score": 50
      },
      {
        "field": "name",
        "pattern": "* (1)*",
        "score": 40
      },
      {
        "field": "path",
        "pattern": "*/Importations/*",
        "score": 30
      },
      {
        "field": "path",
        "pattern": "*/Old/*",
        "score": 20
      },
      {
        "field": "path",
        "pattern": "*/bureau/*",
        "score": 10
      }
    ]
  }
